---
/**
 * Base layout for the entire EDDI website.
 * Provides the HTML shell, global styles, meta tags, JSON-LD,
 * theme toggle script, and i18n hreflang alternates.
 */
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CookieConsent from "../components/CookieConsent.astro";
import LanguageSuggestion from "../components/LanguageSuggestion.astro";
import { EDDI_VERSION, EDDI_LATEST_VERSION } from "../i18n/version";
import { MCP_TOOLS, LLM_PROVIDERS } from "../i18n/stats";
import "../styles/global.css";
import {
  LOCALE_CODES,
  getLocaleFromUrl,
  getPathWithoutLocale,
  getDir,
  localePath,
  type Locale,
} from "../i18n";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description?: string;
  /** Full-bleed page (no content wrapper) — used by homepage */
  fullWidth?: boolean;
  /** Explicit locale override (otherwise derived from URL) */
  lang?: Locale;
  /** FAQ entries to emit as FAQPage structured data (only pages with a visible FAQ section should pass this) */
  faqItems?: { question: string; answer: string }[];
  /**
   * False for pages that exist in English only (no `/{lang}/` route). Suppresses
   * hreflang and og:locale:alternate, and re-points the language switcher at the
   * locale homepages so it cannot link into a 404.
   */
  localized?: boolean;
  /**
   * Set on editorial pages (guides). Appends a TechArticle node to the JSON-LD
   * graph and emits the article Open Graph tags.
   */
  article?: {
    datePublished: Date;
    dateModified?: Date;
    section?: string;
    keywords?: string[];
  };
}

const {
  title,
  description: descProp,
  fullWidth = false,
  lang: langProp,
  faqItems,
  localized = true,
  article,
} = Astro.props;

const lang = langProp ?? getLocaleFromUrl(Astro.url);
const dir = getDir(lang);

// Use locale-aware description fallback instead of hardcoded English
import { getTranslations } from "../i18n";
const tMeta = await getTranslations(lang);
const description = descProp ?? tMeta.meta.siteDescription;
const siteUrl = Astro.site?.toString() || "https://eddi.technology";
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const pagePath = getPathWithoutLocale(Astro.url);

// OG locale mapping (ISO 639-1 → Open Graph format)
const OG_LOCALE_MAP: Record<string, string> = {
  en: "en_US",
  de: "de_DE",
  es: "es_ES",
  fr: "fr_FR",
  pt: "pt_BR",
  ar: "ar_SA",
  zh: "zh_CN",
  ja: "ja_JP",
  ko: "ko_KR",
  hi: "hi_IN",
  th: "th_TH",
};
const ogLocale = OG_LOCALE_MAP[lang] || lang;

// Region-tagged hreflang codes (same regions as the sitemap i18n map in astro.config.mjs)
const HREFLANG_MAP: Record<string, string> = Object.fromEntries(
  Object.entries(OG_LOCALE_MAP).map(([code, og]) => [code, og.replace("_", "-")]),
);

// Strip HTML tags from FAQ answers for structured data
const stripHtml = (html: string) => html.replace(/<[^>]*>/g, "");

// ─── Structured data ────────────────────────────────────────────────
// One @graph instead of four disconnected blocks: search engines resolve
// Organization, WebSite, SoftwareApplication, and the current WebPage as a
// single connected entity when they reference each other by @id.
const siteOrigin = new URL(siteUrl).origin;
const ORG_ID = `${siteOrigin}/#organization`;
const LOGO_ID = `${siteOrigin}/#logo`;
const SITE_ID = `${siteOrigin}/#website`;
const APP_ID = `${siteOrigin}/#eddi`;
const pageId = `${canonicalURL}#webpage`;

const jsonLdGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": ORG_ID,
      name: "LABS.AI",
      url: siteOrigin,
      logo: { "@id": LOGO_ID },
      image: { "@id": LOGO_ID },
      // Only profiles that are verifiably ours: adding unowned URLs here
      // actively harms entity resolution.
      sameAs: [
        "https://github.com/labsai",
        "https://github.com/labsai/EDDI",
        "https://hub.docker.com/r/labsai/eddi",
      ],
    },
    {
      "@type": "ImageObject",
      "@id": LOGO_ID,
      url: `${siteOrigin}/eddi-icon.png`,
      contentUrl: `${siteOrigin}/eddi-icon.png`,
      width: 512,
      height: 512,
      caption: "EDDI",
    },
    {
      "@type": "WebSite",
      "@id": SITE_ID,
      name: "EDDI",
      url: siteOrigin,
      description: `EDDI ${EDDI_VERSION}: The Enterprise AI Orchestrator. Self-hosted, configuration-driven AI agent platform with visual management, security-first architecture, and built-in compliance.`,
      publisher: { "@id": ORG_ID },
      inLanguage: HREFLANG_MAP[lang] || lang,
    },
    {
      "@type": "SoftwareApplication",
      "@id": APP_ID,
      name: "EDDI",
      applicationCategory: "DeveloperApplication",
      operatingSystem: "Cross-platform (JVM)",
      description: `Self-hosted enterprise AI orchestration platform with a visual management UI, ${MCP_TOOLS} MCP tools, and built-in compliance.`,
      url: siteOrigin,
      downloadUrl: "https://github.com/labsai/EDDI",
      softwareVersion: EDDI_LATEST_VERSION,
      releaseNotes: `https://github.com/labsai/EDDI/releases/tag/${EDDI_LATEST_VERSION}`,
      featureList: [
        "Configuration-as-code AI agents defined in JSON",
        `${MCP_TOOLS} MCP tools for AI-native control`,
        "Multi-agent group discussions with 7 styles, voting, and humans as members",
        "Human-in-the-loop approval gates for turns, tool calls, and group phases",
        "Per-user workspaces with resource sharing",
        "Connections with OAuth2 and per-user credentials",
        "OpenAI-compatible API for Open WebUI and OpenAI clients",
        "A2A protocol and OpenAPI 3.1",
        `${LLM_PROVIDERS} LLM providers with model cascading`,
        "RAG with 7 embedding providers and 6 vector stores",
        "Immutable cryptographic audit trail",
        "GDPR, EU AI Act, and HIPAA compliance tooling",
      ],
      license: "https://www.apache.org/licenses/LICENSE-2.0",
      author: { "@id": ORG_ID },
      publisher: { "@id": ORG_ID },
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    },
    {
      // A page with a visible FAQ is typed as both, so the Q&A pairs hang off
      // the same node rather than a second, orphaned FAQPage.
      "@type":
        faqItems && faqItems.length > 0 ? ["WebPage", "FAQPage"] : "WebPage",
      "@id": pageId,
      url: canonicalURL.toString(),
      name: `${title} | EDDI`,
      description,
      isPartOf: { "@id": SITE_ID },
      about: { "@id": APP_ID },
      inLanguage: HREFLANG_MAP[lang] || lang,
      ...(faqItems && faqItems.length > 0
        ? {
            mainEntity: faqItems.map((item) => ({
              "@type": "Question",
              name: item.question,
              acceptedAnswer: {
                "@type": "Answer",
                text: stripHtml(item.answer),
              },
            })),
          }
        : {}),
    },
    ...(article
      ? [
          {
            "@type": "TechArticle",
            "@id": `${pageId}-article`,
            headline: title,
            description,
            mainEntityOfPage: { "@id": pageId },
            isPartOf: { "@id": SITE_ID },
            about: { "@id": APP_ID },
            author: { "@id": ORG_ID },
            publisher: { "@id": ORG_ID },
            image: { "@id": LOGO_ID },
            inLanguage: HREFLANG_MAP[lang] || lang,
            datePublished: article.datePublished.toISOString(),
            dateModified: (
              article.dateModified ?? article.datePublished
            ).toISOString(),
            ...(article.section ? { articleSection: article.section } : {}),
            ...(article.keywords?.length
              ? { keywords: article.keywords.join(", ") }
              : {}),
          },
        ]
      : []),
  ],
};
---

<!doctype html>
<html lang={lang} dir={dir} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <ClientRouter />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/eddi-icon.png" />
    <link rel="canonical" href={canonicalURL} />

    <title>{title} | EDDI</title>
    <meta name="description" content={description} />

    <!-- Hreflang alternates (localized pages only) -->
    {
      localized && (
        <>
          {LOCALE_CODES.map((loc) => (
            <link
              rel="alternate"
              hreflang={HREFLANG_MAP[loc] || loc}
              href={new URL(localePath(loc, pagePath), siteUrl)}
            />
          ))}
          <link
            rel="alternate"
            hreflang="x-default"
            href={new URL(pagePath, siteUrl)}
          />
        </>
      )
    }

    <!-- OG / Twitter -->
    <meta property="og:type" content={article ? "article" : "website"} />
    {
      article && (
        <>
          <meta
            property="article:published_time"
            content={article.datePublished.toISOString()}
          />
          <meta
            property="article:modified_time"
            content={(
              article.dateModified ?? article.datePublished
            ).toISOString()}
          />
          {article.section && (
            <meta property="article:section" content={article.section} />
          )}
          {article.keywords?.map((keyword) => (
            <meta property="article:tag" content={keyword} />
          ))}
        </>
      )
    }
    <meta property="og:site_name" content="EDDI" />
    <meta property="og:title" content={`${title} | EDDI`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content="https://eddi.technology/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="EDDI: The Enterprise AI Orchestrator" />
    <meta property="og:locale" content={ogLocale} />
    {
      localized &&
        LOCALE_CODES.filter((l) => l !== lang).map((l) => (
          <meta property="og:locale:alternate" content={OG_LOCALE_MAP[l] || l} />
        ))
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | EDDI`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://eddi.technology/og-image.png" />

    <!-- LLM / AI agent discovery -->
    <link rel="alternate" type="text/markdown" href="/llms.txt" />
    <link rel="alternate" type="text/markdown" href="/llms-full.txt" />

    <!-- JSON-LD: single @graph (Organization + WebSite + SoftwareApplication + WebPage) -->
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(jsonLdGraph)}
    />

    <!-- Theme init (no flash) -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem("eddi-theme");
        const theme =
          stored ||
          (window.matchMedia("(prefers-color-scheme: light)").matches
            ? "light"
            : "dark");
        document.documentElement.setAttribute("data-theme", theme);
      })();

      // Persist theme across Astro View Transitions (ClientRouter).
      // astro:before-swap fires before the new document is painted,
      // so we copy the current theme onto the incoming document to
      // prevent it from flashing dark (the server-rendered default).
      document.addEventListener("astro:before-swap", (e) => {
        const theme = document.documentElement.getAttribute("data-theme");
        if (theme) {
          e.newDocument.documentElement.setAttribute("data-theme", theme);
        }
      });
    </script>

    <!-- Fonts: self-hosted via fontsource (no Google CDN requests) -->
  </head>
  <body>
    <a href="#main-content" class="skip-to-content">Skip to content</a>
    <Header lang={lang} localized={localized} />

    {
      fullWidth ? (
        <main id="main-content">
          <slot />
        </main>
      ) : (
        <main id="main-content" class="page-content">
          <slot />
        </main>
      )
    }

    <Footer lang={lang} />

    <!-- Global Copy Button Script for pre elements -->
    <script is:inline>
      document.addEventListener("astro:page-load", () => {
        document.querySelectorAll("pre").forEach((pre) => {
          // Skip if already wrapped (idempotency guard for ClientRouter transitions)
          if (pre.closest(".eddi-pre-wrapper")) return;

          const button = document.createElement("button");
          button.className = "eddi-copy-btn";
          button.innerHTML =
            '<svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>';
          button.ariaLabel = "Copy code";

          button.addEventListener("click", async () => {
            const code = pre.querySelector("code")?.innerText || pre.innerText;
            try {
              await navigator.clipboard.writeText(code);
              button.classList.add("copied");
              button.innerHTML =
                '<svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';
              setTimeout(() => {
                button.classList.remove("copied");
                button.innerHTML =
                  '<svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>';
              }, 2000);
            } catch (err) {
              console.error("Failed to copy", err);
            }
          });

          const wrapper = document.createElement("div");
          wrapper.className = "eddi-pre-wrapper";
          pre.parentNode.insertBefore(wrapper, pre);
          wrapper.appendChild(pre);
          wrapper.appendChild(button);
        });
      });
    </script>

    <CookieConsent lang={lang} t={tMeta} />
    {localized && <LanguageSuggestion lang={lang} />}

    <!-- Email deobfuscation: assembles mailto links client-side to prevent scraping -->
    <script is:inline>
      document.addEventListener("astro:page-load", function () {
        document.querySelectorAll(".obfuscated-email").forEach(function (el) {
          var u = el.getAttribute("data-u");
          var d = el.getAttribute("data-d");
          if (u && d) {
            var addr = u + "@" + d;
            var a = document.createElement("a");
            a.href = "mailto:" + addr;
            a.textContent = addr;
            // Preserve any additional classes from the span
            if (el.className) {
              el.className.split(" ").forEach(function (cls) {
                if (cls && cls !== "obfuscated-email") a.classList.add(cls);
              });
            }
            el.replaceWith(a);
          }
        });
      });
    </script>

    <!-- Dynamic banner height measurement -->
    <script is:inline>
      function syncBannerHeight() {
        var banner = document.getElementById('eddi-announcement-banner');
        var h = 0;
        if (banner && getComputedStyle(banner).display !== 'none') {
          h = banner.offsetHeight;
        }
        document.documentElement.style.setProperty('--banner-height', h + 'px');
        document.documentElement.style.setProperty('--total-header-height', 'calc(' + h + 'px + var(--nav-height, 4rem))');
      }
      syncBannerHeight();
      window.addEventListener('resize', syncBannerHeight);
      document.addEventListener('astro:page-load', syncBannerHeight);
    </script>
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    min-height: 100vh;
  }

  /* Skip to Content for Screen Readers */
  .skip-to-content {
    position: absolute;
    top: -100%;
    inset-inline-start: 50%;
    transform: translateX(-50%);
    background: var(--color-accent-500);
    color: #000;
    padding: 0.5rem 1rem;
    border-radius: 0 0 0.5rem 0.5rem;
    z-index: 9999;
    transition: top 0.2s ease;
    font-weight: 600;
  }
  .skip-to-content:focus {
    top: 0;
  }

  /* Full-width pages get no wrapper */
  main.page-content {
    max-width: 72rem;
    margin: 0 auto;
    padding: calc(var(--total-header-height, 6rem) + 2rem) 1.5rem 4rem;
  }

  /* Global Code Copy UI */
  .eddi-pre-wrapper {
    position: relative;
    margin-bottom: 1rem;
  }
  .eddi-pre-wrapper pre {
    margin-bottom: 0 !important;
  }
  .eddi-copy-btn {
    position: absolute;
    top: 0.5rem;
    inset-inline-end: 0.5rem;
    padding: 0.4rem;
    border-radius: 0.375rem;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--color-text-muted);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
    z-index: 10;
  }
  html[data-theme="light"] .eddi-copy-btn {
    background: rgba(0, 0, 0, 0.05);
    border: 1px solid rgba(0, 0, 0, 0.1);
  }
  .eddi-copy-btn:hover {
    color: var(--color-text);
    background: rgba(255, 255, 255, 0.2);
  }
  html[data-theme="light"] .eddi-copy-btn:hover {
    background: rgba(0, 0, 0, 0.1);
  }
  .eddi-copy-btn.copied {
    color: var(--color-accent-400);
    border-color: var(--color-accent-500);
    background: color-mix(in srgb, var(--color-accent) 15%, transparent);
  }
</style>
