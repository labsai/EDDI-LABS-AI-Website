---
/**
 * Guide layout — long-form, task-oriented walkthroughs at /guides/*.
 *
 * Deliberately not FeaturePage: a guide is read top to bottom, so it gets a
 * text header with metadata and a narrow measure rather than a 1024px hero
 * image and a marketing CTA above the first instruction.
 */
import BaseLayout from './BaseLayout.astro';
import { PERSONAS, type PersonaKey } from '../content.config';

interface Props {
	title: string;
	description: string;
	persona: PersonaKey;
	level: 'beginner' | 'intermediate' | 'advanced';
	timeMinutes: number;
	publishDate: Date;
	updatedDate?: Date;
	docsLinks?: { label: string; href: string }[];
	faq?: { question: string; answer: string }[];
	tags?: string[];
	/** Rendered heading tree from `render(entry)`, used for the contents list. */
	headings?: { depth: number; slug: string; text: string }[];
}

const {
	title,
	description,
	persona,
	level,
	timeMinutes,
	publishDate,
	updatedDate,
	docsLinks = [],
	faq = [],
	tags = [],
	headings = [],
} = Astro.props;

const LEVEL_LABELS = {
	beginner: 'Beginner',
	intermediate: 'Intermediate',
	advanced: 'Advanced',
} as const;

// Only h2s: a guide's h3s are steps within a section and make the list noisy.
const contents = headings.filter((h) => h.depth === 2);

const dateFormat = new Intl.DateTimeFormat('en-GB', {
	day: 'numeric',
	month: 'short',
	year: 'numeric',
});
const shownDate = updatedDate ?? publishDate;
---

<BaseLayout
	title={title}
	description={description}
	fullWidth={true}
	lang="en"
	localized={false}
	faqItems={faq.length > 0 ? faq : undefined}
	article={{
		datePublished: publishDate,
		dateModified: updatedDate,
		section: PERSONAS[persona],
		keywords: tags,
	}}
>

<article class="guide">

	<header class="guide-header">
		<nav class="guide-crumbs" aria-label="Breadcrumb">
			<a href="/">Home</a>
			<span aria-hidden="true">/</span>
			<a href="/guides/">Guides</a>
		</nav>

		<h1>{title}</h1>
		<p class="guide-standfirst">{description}</p>

		<dl class="guide-meta">
			<div><dt>For</dt><dd>{PERSONAS[persona]}</dd></div>
			<div><dt>Level</dt><dd>{LEVEL_LABELS[level]}</dd></div>
			<div><dt>Time</dt><dd>{timeMinutes} min</dd></div>
			<div>
				<dt>{updatedDate ? 'Updated' : 'Published'}</dt>
				<dd><time datetime={shownDate.toISOString()}>{dateFormat.format(shownDate)}</time></dd>
			</div>
		</dl>
	</header>

	<div class="guide-body">
		{contents.length > 2 && (
			<nav class="guide-toc" aria-label="On this page">
				<p class="guide-toc-label">On this page</p>
				<ol>
					{contents.map((heading) => (
						<li><a href={`#${heading.slug}`}>{heading.text}</a></li>
					))}
				</ol>
			</nav>
		)}

		<div class="guide-prose">
			<slot />

			{faq.length > 0 && (
				<section class="guide-faq">
					<h2 id="frequently-asked">Frequently asked</h2>
					{faq.map((item) => (
						<div class="guide-faq-item">
							<h3>{item.question}</h3>
							<p>{item.answer}</p>
						</div>
					))}
				</section>
			)}

			{docsLinks.length > 0 && (
				<section class="guide-refs">
					<h2 id="reference-documentation">Reference documentation</h2>
					<p>
						This guide covers the path from nothing to working. For the complete
						field reference and advanced configuration, continue in the docs:
					</p>
					<ul>
						{docsLinks.map((link) => (
							<li>
								<a href={link.href} target="_blank" rel="noopener">{link.label} ↗</a>
							</li>
						))}
					</ul>
				</section>
			)}

			<slot name="footer" />
		</div>
	</div>
</article>

</BaseLayout>

<style>
	.guide {
		max-width: 60rem;
		margin: 0 auto;
		padding: calc(var(--total-header-height, 6rem) + 2.5rem) 1.5rem 6rem;
	}

	/* ── Header ─────────────────────────────────────────────── */

	.guide-crumbs {
		display: flex;
		gap: 0.5rem;
		font-size: 0.8125rem;
		color: var(--color-text-subtle);
		margin-bottom: 1.25rem;
	}
	.guide-crumbs span {
		opacity: 0.5;
	}

	.guide-header h1 {
		font-size: clamp(1.875rem, 4vw, 2.75rem);
		font-weight: 800;
		line-height: 1.15;
		margin: 0 0 1rem;
		color: var(--color-text);
		text-wrap: balance;
	}

	.guide-standfirst {
		font-size: 1.125rem;
		line-height: 1.65;
		color: var(--color-text-muted);
		margin: 0 0 1.75rem;
		max-width: 44rem;
	}

	.guide-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 2rem;
		margin: 0 0 2.5rem;
		padding: 1rem 1.25rem;
		border-radius: 0.75rem;
		border: 1px solid var(--color-border, rgba(255, 255, 255, 0.1));
		background: var(--color-surface-elevated, rgba(255, 255, 255, 0.03));
	}
	.guide-meta > div {
		display: flex;
		flex-direction: column;
		gap: 0.125rem;
	}
	.guide-meta dt {
		font-size: 0.6875rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-text-subtle);
	}
	.guide-meta dd {
		margin: 0;
		font-size: 0.9375rem;
		font-weight: 600;
		color: var(--color-text);
	}

	/* ── Contents ───────────────────────────────────────────── */

	.guide-toc {
		margin: 0 0 2.5rem;
		padding: 1.25rem 1.5rem;
		border-radius: 0.75rem;
		border: 1px solid var(--color-border, rgba(255, 255, 255, 0.1));
		background: var(--color-surface-elevated, rgba(255, 255, 255, 0.03));
	}
	.guide-toc-label {
		margin: 0 0 0.625rem;
		font-size: 0.6875rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-text-subtle);
	}
	.guide-toc ol {
		margin: 0;
		padding-inline-start: 1.25rem;
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
	}
	.guide-toc li {
		font-size: 0.9375rem;
	}

	/* ── Prose ──────────────────────────────────────────────── */

	.guide-prose {
		color: var(--color-text-muted);
		line-height: 1.75;
	}

	.guide-prose :global(h2) {
		font-size: 1.5rem;
		font-weight: 700;
		color: var(--color-text);
		margin: 3rem 0 1rem;
		scroll-margin-top: calc(var(--total-header-height, 6rem) + 1rem);
	}

	.guide-prose :global(h3) {
		font-size: 1.1875rem;
		font-weight: 600;
		color: var(--color-text);
		margin: 2rem 0 0.75rem;
		scroll-margin-top: calc(var(--total-header-height, 6rem) + 1rem);
	}

	.guide-prose :global(p) {
		margin: 0 0 1rem;
	}

	.guide-prose :global(strong) {
		color: var(--color-text);
	}

	.guide-prose :global(ul),
	.guide-prose :global(ol) {
		padding-inline-start: 1.5rem;
		margin: 0 0 1rem;
	}

	.guide-prose :global(li) {
		margin-bottom: 0.5rem;
	}

	.guide-prose :global(pre) {
		padding: 1rem 1.25rem;
		margin: 0 0 1.5rem;
		overflow-x: auto;
		font-size: 0.875rem;
		line-height: 1.6;
	}

	.guide-prose :global(blockquote) {
		margin: 0 0 1.5rem;
		padding: 1rem 1.25rem;
		border-inline-start: 3px solid var(--color-accent, hsl(45, 100%, 51%));
		border-radius: 0 0.5rem 0.5rem 0;
		background: var(--color-surface-elevated, rgba(255, 255, 255, 0.03));
	}
	.guide-prose :global(blockquote p:last-child) {
		margin-bottom: 0;
	}

	.guide-prose :global(table) {
		width: 100%;
		border-collapse: collapse;
		margin: 1rem 0 2rem;
		font-size: 0.925rem;
		line-height: 1.5;
	}
	.guide-prose :global(th) {
		text-align: start;
		padding: 0.75rem 1rem;
		font-weight: 700;
		color: var(--color-text);
		background: var(--color-surface-elevated, rgba(255, 255, 255, 0.05));
		border-bottom: 2px solid var(--color-accent, hsl(45, 100%, 51%));
	}
	.guide-prose :global(td) {
		padding: 0.75rem 1rem;
		border-bottom: 1px solid var(--color-border, rgba(255, 255, 255, 0.1));
		vertical-align: top;
	}
	.guide-prose :global(tr:last-child td) {
		border-bottom: none;
	}

	.guide-prose :global(hr) {
		border: 0;
		border-top: 1px solid var(--color-border, rgba(255, 255, 255, 0.1));
		margin: 2.5rem 0;
	}

	/* Wide content must scroll inside itself, never the page */
	.guide-prose :global(.table-scroll) {
		overflow-x: auto;
	}

	/* ── Trailing sections ──────────────────────────────────── */

	.guide-faq-item {
		margin-bottom: 1.5rem;
	}
	.guide-faq-item h3 {
		margin-bottom: 0.5rem;
	}

	.guide-refs ul {
		margin-bottom: 0;
	}

	@media (max-width: 640px) {
		.guide-meta {
			gap: 0.75rem 1.25rem;
		}
	}
</style>
