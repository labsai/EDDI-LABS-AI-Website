</p>

<ol class="refs">
	{[...CASCADE_EVIDENCE, ...GOVERNANCE_EVIDENCE, ...OVERSIGHT_EVIDENCE, ...DELIBERATION_EVIDENCE, ...MEMORY_EVIDENCE, ...CONCURRENCY_EVIDENCE, ...RETRIEVAL_EVIDENCE].map((row) => (
		<li>
			{row.study}. <a href={doiUrl(row.doi)} target="_blank" rel="noopener">doi.org/{row.doi}</a>
		</li>
	))}
</ol>

<!-- Enterprise & Commercial CTA -->
<div class="enterprise-cta">
	<h2>{t.common.enterpriseCtaTitle}</h2>
	<p>{t.common.enterpriseCtaDesc}</p>
	<a href={enterpriseCtaHref} class="btn-cta-primary" target={SOLUTIONS_LIVE ? '_blank' : undefined} rel={SOLUTIONS_LIVE ? 'noopener' : undefined}>{t.common.enterpriseCtaBtn}</a>
</div>

</FeaturePage>

<style>
	.chart { margin: 1.5rem 0 2rem; }
	.chart svg { display: block; width: 100%; max-width: 40rem; height: auto; }
	.chart .chart-label { fill: var(--color-text-muted); font-size: 13px; }
	.chart .chart-value { fill: var(--color-text); font-size: 13px; font-weight: 600; font-variant-numeric: tabular-nums; }
	.chart .bar { fill: var(--color-text-muted); opacity: 0.45; }
	.chart .bar-accent { fill: var(--color-accent); }
	.chart figcaption { font-size: 0.8125rem; color: var(--color-text-muted); margin-top: 0.5rem; }
	.verdict {
		margin: 0 0 2.5rem;
		padding: 1.5rem 1.75rem;
		border-radius: 0.75rem;
		border: 1px solid color-mix(in srgb, var(--color-accent, hsl(45, 100%, 51%)) 35%, transparent);
