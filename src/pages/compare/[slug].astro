---
/**
 * Head-to-head comparison pages: /compare/{slug}/ (English).
 * The [lang] variant serves the other 10 locales. Copy: src/i18n/compare/.
 */
import CompareContent from '../../components/pages/CompareContent.astro';
import { COMPARISONS } from '../../data/comparisons';
import { enTranslations as t } from '../../i18n';

export function getStaticPaths() {
	return COMPARISONS.map((c) => ({ params: { slug: c.slug } }));
}
const { slug } = Astro.params as { slug: string };
---
<CompareContent lang="en" t={t} slug={slug} />
