---
import FeaturePage from '../../layouts/FeaturePage.astro';
import heroImage from '../../assets/hero_compliance.webp';
import { enTranslations as t } from '../../i18n';
const p = t.pages.humanInTheLoop;
---
<FeaturePage title={p.title} description={p.description} heroImage={heroImage} lang="en">
<h2>{p.heading1}</h2><p set:html={p.para1} />

<!-- Why the platform owns the gate -->
<h3>{p.whyTitle}</h3>
<p set:html={p.whyPara} />

<!-- Approval surfaces -->
<h2>{p.heading2}</h2>
<ul>{p.items.map((item) => <li set:html={item} />)}</ul>

<!-- Timeout policies -->
<h2>{p.timeoutTitle}</h2>
<p set:html={p.timeoutPara} />
<ul>{p.timeoutItems.map((item) => <li set:html={item} />)}</ul>

<!-- Production behaviour -->
<h2>{p.opsTitle}</h2>
<p set:html={p.opsPara} />
<ul>{p.opsItems.map((item) => <li set:html={item} />)}</ul>

<!-- Governance -->
<h3>{p.govTitle}</h3>
<p set:html={p.govPara} />
</FeaturePage>
