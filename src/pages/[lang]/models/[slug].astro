---
import ModelDetailContent from '../../../components/pages/ModelDetailContent.astro';
import { NON_DEFAULT_LOCALES, getTranslations, type Locale } from '../../../i18n';
import { MODELS, type ModelFamily } from '../../../data/models';

export async function getStaticPaths() {
	return NON_DEFAULT_LOCALES.flatMap((lang) => MODELS.map((model) => ({ params: { lang, slug: model.slug }, props: { model } })));
}
const { lang } = Astro.params as { lang: Locale };
const { model } = Astro.props as { model: ModelFamily };
const t = await getTranslations(lang);
---
<ModelDetailContent lang={lang} t={t} model={model} />
