---
/**
 * Integration catalog index (/integrations/): every system EDDI connects to, with a
 * category filter and search. Shared by the root and [lang] routes.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localePath, type Locale } from '../../i18n';
import { getIntegrationsCopy } from '../../i18n/integrations';
import { INTEGRATIONS, CATEGORY_ORDER } from '../../data/integrations';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const copy = await getIntegrationsCopy(lang);
const ui = copy.ui;
const withLocale = (html: string) => (lang === 'en' ? html : html.replaceAll('href="/', `href="/${lang}/`));
const ordered = [...INTEGRATIONS].sort((a, b) => CATEGORY_ORDER.indexOf(a.category) - CATEGORY_ORDER.indexOf(b.category));
const filters = [{ id: 'all', label: ui.filterAll }, ...CATEGORY_ORDER.map((c) => ({ id: c, label: copy.categories[c] }))];
---
<BaseLayout title={ui.title} metaTitle={ui.metaTitle} description={ui.description} fullWidth={true} lang={lang}>
<section class="ic-hero hero-gradient-bg">
	<div class="ic-hero-inner">
		<h1>{ui.heroTitle} <span class="text-gradient-dynamic">{ui.heroHighlight}</span></h1>
		<p set:html={ui.heroDesc} />
	</div>
</section>

<article class="ic-content">
	<div class="ic-controls">
		<div class="ic-filters" role="group" aria-label={ui.filterLabel}>
			{filters.map((f, i) => (
				<button type="button" class:list={['ic-chip', { active: i === 0 }]} data-filter={f.id} aria-pressed={i === 0 ? 'true' : 'false'}>{f.label}</button>
			))}
		</div>
		<label class="ic-search">
			<span class="sr-only">{ui.searchLabel}</span>
			<input id="ic-search-input" type="search" placeholder={ui.searchPlaceholder} autocomplete="off" />
		</label>
	</div>

	<div class="ic-grid" id="ic-grid">
		{ordered.map((item) => {
			const c = copy.integrations[item.slug];
			const search = [item.name, item.tag, copy.categories[item.category], c.summary, ...item.keywords].join(' ').toLowerCase();
			return (
				<a href={localePath(lang, `/integrations/${item.slug}/`)} class="ic-card" data-tags={item.category} data-search={search}>
					<div class="ic-card-head">
						<span class="ic-cat">{copy.categories[item.category]}</span>
						<span class="ic-tag" dir="ltr">{item.tag}</span>
					</div>
					<h2>{item.name}</h2>
					<p>{c.summary}</p>
				</a>
			);
		})}
	</div>
	<p class="ic-empty" id="ic-empty" hidden>{ui.noResults}</p>

	<aside class="ic-note">
		<p set:html={withLocale(ui.notCoveredNote)} />
	</aside>

	<section class="ic-cta">
		<h2>{ui.ctaTitle}</h2>
		<p set:html={withLocale(ui.ctaDesc)} />
		<a href={localePath(lang, '/getting-started/')} class="btn-cta-primary">{ui.getStarted}</a>
	</section>
</article>
</BaseLayout>

<script>
	function initIntegrationFilter() {
		const grid = document.getElementById('ic-grid');
		if (!grid) return;
		const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.ic-chip'));
		const input = document.getElementById('ic-search-input') as HTMLInputElement | null;
		const empty = document.getElementById('ic-empty');
		let active = 'all';
		const apply = () => {
			const q = (input?.value ?? '').trim().toLowerCase();
			let shown = 0;
			grid.querySelectorAll<HTMLElement>('.ic-card').forEach((card) => {
				const tagOk = active === 'all' || (card.dataset.tags ?? '').split(' ').includes(active);
				const textOk = !q || (card.dataset.search ?? '').includes(q);
				card.hidden = !(tagOk && textOk);
				if (!card.hidden) shown++;
			});
			if (empty) empty.hidden = shown > 0;
		};
		chips.forEach((chip) => chip.addEventListener('click', () => {
			active = chip.dataset.filter ?? 'all';
			chips.forEach((c) => { c.classList.toggle('active', c === chip); c.setAttribute('aria-pressed', c === chip ? 'true' : 'false'); });
			apply();
		}));
		input?.addEventListener('input', apply);
	}
	document.addEventListener('astro:page-load', initIntegrationFilter);
</script>

<style>
	.ic-hero { padding: calc(var(--total-header-height, 6rem) + 4rem) 1.5rem 2.5rem; text-align: center; }
	.ic-hero-inner { max-width: 52rem; margin: 0 auto; }
	.ic-hero h1 { font-size: clamp(2rem, 5vw, 3.25rem); font-weight: 800; color: var(--color-text); margin: 0 0 1rem; text-wrap: balance; }
	.ic-hero p { color: var(--color-text-muted); font-size: 1.125rem; line-height: 1.6; margin: 0; }
	.ic-content { max-width: 72rem; margin: 0 auto; padding: 1.5rem 1.5rem 6rem; }
	.ic-controls { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; justify-content: space-between; margin-bottom: 1.75rem; }
	.ic-filters { display: flex; flex-wrap: wrap; gap: 0.5rem; }
	.ic-chip { font: inherit; font-size: 0.875rem; font-weight: 600; padding: 0.45rem 0.9rem; border-radius: 9999px; cursor: pointer; background: transparent; color: var(--color-text-muted); border: 1px solid var(--color-border, rgba(127, 127, 127, 0.3)); transition: all 0.2s; }
	.ic-chip:hover { color: var(--color-text); border-color: var(--color-accent); }
	.ic-chip.active { background: var(--color-accent); border-color: var(--color-accent); color: #fff; }
	.ic-chip:focus-visible, .ic-search input:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
	.ic-search input { font: inherit; font-size: 0.9375rem; width: min(22rem, 100%); padding: 0.55rem 0.9rem; border-radius: 0.6rem; background: transparent; color: var(--color-text); border: 1px solid var(--color-border, rgba(127, 127, 127, 0.3)); }
	.ic-search { flex: 1 1 16rem; display: flex; justify-content: flex-end; }
	.ic-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr)); gap: 1.25rem; }
	.ic-card { display: flex; flex-direction: column; gap: 0.6rem; padding: 1.5rem; border-radius: 1rem; text-decoration: none; transition: transform 0.2s, border-color 0.2s; min-width: 0; }
	.ic-card[hidden] { display: none; }
	html[data-theme='dark'] .ic-card { background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.08); }
	html[data-theme='light'] .ic-card { background: #f5f6f8; border: 1px solid rgba(0, 0, 0, 0.06); }
	.ic-card:hover { transform: translateY(-3px); border-color: var(--color-accent); }
	.ic-card:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
	.ic-card-head { display: flex; justify-content: space-between; gap: 0.5rem; align-items: center; flex-wrap: wrap; }
	.ic-cat { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-text-muted); }
	.ic-tag { font-size: 0.6875rem; font-weight: 600; padding: 0.15rem 0.5rem; border-radius: 9999px; color: var(--color-accent); border: 1px solid var(--color-accent); font-family: ui-monospace, monospace; overflow-wrap: anywhere; }
	.ic-card h2 { font-size: 1.1875rem; font-weight: 700; color: var(--color-text); margin: 0; }
	.ic-card p { font-size: 0.875rem; line-height: 1.55; color: var(--color-text-muted); margin: 0; }
	.ic-empty { text-align: center; color: var(--color-text-muted); padding: 2rem 0; }
	.ic-note { margin-top: 3rem; padding: 1.25rem 1.5rem; border-radius: 0.9rem; border: 1px solid var(--color-border, rgba(127, 127, 127, 0.3)); }
	.ic-note p { margin: 0; color: var(--color-text-muted); line-height: 1.65; font-size: 0.9375rem; }
	.ic-note :global(a), .ic-cta :global(a:not(.btn-cta-primary)) { color: var(--color-accent); }
	.ic-cta { margin-top: 4rem; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 0.75rem; }
	.ic-cta h2 { font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 800; color: var(--color-text); margin: 0; }
	.ic-cta p { color: var(--color-text-muted); max-width: 40rem; line-height: 1.6; margin: 0 0 0.5rem; }
	.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
</style>
