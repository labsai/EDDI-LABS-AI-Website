---
/**
 * A card that links to a page, and may still carry its own links in the description.
 *
 * The card is not an <a>: a description with a link inside (for example the
 * benchmarks "evidence" link) would nest anchors, and the HTML parser closes the
 * outer one early, which spills the rest of the card out of its box. Instead the
 * title is the link, stretched over the whole card with a pseudo-element, and any
 * links in the description sit above that overlay.
 */
interface Props {
	href?: string;
	title: string;
	desc: string;
	/** Smaller, centered tile used for the tools grid. */
	compact?: boolean;
}

const { href, title, desc, compact = false } = Astro.props;
const external = href?.startsWith('http');
---
{compact ? (
	<div class:list={['relative flex flex-col items-center text-center p-5 rounded-2xl bg-zinc-900/30 backdrop-blur border border-zinc-800 transition-all duration-300 group', href && 'hover:border-accent-500/50 hover:-translate-y-1 hover:shadow-lg focus-within:border-accent-500/50']}>
		<slot name="icon" />
		{href ? (
			<a href={href} class="fc-link text-white text-sm mb-1 font-bold no-underline after:absolute after:inset-0 after:rounded-2xl after:content-['']">{title}</a>
		) : (
			<strong class="text-white text-sm mb-1">{title}</strong>
		)}
		<span class="text-xs text-zinc-400">{desc}</span>
	</div>
) : (
	<div class:list={['relative overflow-hidden flex flex-col h-full p-8 rounded-3xl bg-zinc-900/40 backdrop-blur border border-zinc-700/50 transition-all duration-300 shadow-xl group', href && 'hover:border-accent-500/50 hover:-translate-y-2 focus-within:border-accent-500/50']}>
		<h3 class="text-xl font-bold text-white mb-3">
			{href ? (
				<a href={href} class="fc-link text-white! no-underline! after:absolute after:inset-0 after:rounded-3xl after:content-['']" {...(external ? { target: '_blank', rel: 'noopener' } : {})}>{title}</a>
			) : title}
		</h3>
		<p class="text-zinc-400 text-sm leading-relaxed grow [&_a]:relative [&_a]:z-10" set:html={desc} />
		{href && (
			<span aria-hidden="true" class="mt-4 text-accent-400 text-lg leading-none transition-transform duration-300 group-hover:translate-x-1 rtl:-scale-x-100 rtl:group-hover:-translate-x-1">→</span>
		)}
	</div>
)}
<style>
	.fc-link:focus-visible { outline: none; }
	.fc-link:focus-visible::after { outline: 2px solid var(--color-accent-400); outline-offset: -2px; }
</style>
